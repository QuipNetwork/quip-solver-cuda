+/// Probe helper settings (patch 42).
+#[derive(Clone, Debug)]
+pub struct ProbeCfg {
+    /// The probe helper: its command line, `QUIP_OTSUKA_BP_PROBE_TIMEOUT_S`, one read, no re-draws; the
+    /// directory, ready wait and cancel handling are the main helper's.
+    pub helper: BpCfg,
+    /// Candidates probed, 2..=16.
+    pub n: usize,
+}
+
+/// `QUIP_OTSUKA_BP_PROBE_N`: 2..=16; unparsable = 4, out of range is clamped.
+#[must_use]
+pub fn parse_probe_n(v: &str) -> usize {
+    v.trim().parse::<usize>().map_or(4, |n| n.clamp(2, 16))
+}
+
+/// Probe settings from `get` (a key lookup), on top of the main helper's `main`; `None` when
+/// `QUIP_OTSUKA_BP_PROBE_HELPER` is unset or blank.
+#[must_use]
+pub fn probe_cfg_with(main: &BpCfg, get: &dyn Fn(&str) -> Option<String>) -> Option<ProbeCfg> {
+    let mut helper = BpCfg::with_cmd(&get("QUIP_OTSUKA_BP_PROBE_HELPER")?)?;
+    helper.dir = main.dir.clone();
+    helper.ready = main.ready;
+    helper.cancel_wait = main.cancel_wait;
+    helper.cancel_inline = main.cancel_inline;
+    helper.timeout = Duration::from_secs(get("QUIP_OTSUKA_BP_PROBE_TIMEOUT_S").and_then(|v| v.trim().parse().ok()).unwrap_or(30));
+    helper.reads = 1;
+    let n = get("QUIP_OTSUKA_BP_PROBE_N").map_or(4, |v| parse_probe_n(&v));
+    Some(ProbeCfg { helper, n })
+}
+
+/// `probe_cfg_with` on the environment; logs the configuration once per process. Call only when the main
+/// helper is configured.
+#[must_use]
+pub fn probe_cfg(main: &BpCfg) -> Option<ProbeCfg> {
+    let pc = probe_cfg_with(main, &|k| std::env::var(k).ok())?;
+    static LOGGED: Once = Once::new();
+    LOGGED.call_once(|| {
+        tracing::info!(cmd = pc.helper.cmd.as_str(), n = pc.n, timeout_s = pc.helper.timeout.as_secs(), "gpu-pa bp probe configured");
+    });
+    Some(pc)
+}
+
+/// The ladder's final order after one more rung: the rung's own order `cur` first, then the entries of
+/// the order so far `ext` that the rung did not probe, in their order.
+#[must_use]
+pub fn merge_rung_order(ext: &[usize], cur: &[usize]) -> Vec<usize> {
+    let mut v = cur.to_vec();
+    v.extend(ext.iter().copied().filter(|k| !cur.contains(k)));
+    v
+}
+
+/// `[a,b,c]` for log lines.
+#[must_use]
+pub fn fmt_list<I>(v: I) -> String
+where
+    I: IntoIterator,
+    I::Item: std::fmt::Display,
+{
+    format!("[{}]", v.into_iter().map(|x| x.to_string()).collect::<Vec<_>>().join(","))
+}
+
+/// `order` with `first` moved to (or put at) the front.
+#[must_use]
+pub fn with_first(order: &[usize], first: usize) -> Vec<usize> {
+    let mut v = vec![first];
+    v.extend(order.iter().copied().filter(|&k| k != first));
+    v
+}
+
+/// What one probe produced.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ProbeOutcome {
+    /// The verified best read's energy, offset included.
+    Best {
+        /// Energy, offset included.
+        energy: i64,
+        /// The helper's `solve_ms`.
+        helper_ms: u64,
+        /// The helper's stage label.
+        stage: String,
+        /// The helper's `screened_out` flag.
+        screened_out: bool,
+    },
+    /// The lease stopped.
+    Cancelled,
+    /// No usable answer while the probe helper stays up; this candidate keeps its ladder position, last.
+    Failed(String),
+    /// The probe helper is not running (spawn failed, died, killed, or waiting to respawn).
+    Down(String),
+}
+
+/// Probing a ladder's final candidates.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ProbeOrder {
+    /// Positions in the probed list (= ladder rank - 1), in the order the full solves follow.
+    pub order: Vec<usize>,
+    /// The verified probe energy per position of the probed list (`None`: failed or not probed).
+    pub best: Vec<Option<i64>>,
+    /// The lease stopped while probing.
+    pub cancelled: bool,
+    /// The probe helper is down: `order` is the ladder order.
+    pub down: Option<String>,
+}
+
+/// Probe positions `0..n` in order with `probe`, checking `stopped` before each, and order them by probe
+/// energy (best first). Ties keep the ladder order; failed probes follow the probed ones in ladder order.
+/// A down helper ends probing and gives the ladder order; a stop ends probing (the order is then moot).
+pub fn order_by_probe(n: usize, probe: &mut dyn FnMut(usize) -> ProbeOutcome, stopped: &dyn Fn() -> bool) -> ProbeOrder {
+    let mut best: Vec<Option<i64>> = vec![None; n];
+    let mut cancelled = false;
+    let mut down = None;
+    for (k, slot) in best.iter_mut().enumerate() {
+        if stopped() {
+            cancelled = true;
+            break;
+        }
+        match probe(k) {
+            ProbeOutcome::Best { energy, .. } => *slot = Some(energy),
+            ProbeOutcome::Failed(_) => {}
+            ProbeOutcome::Cancelled => {
+                cancelled = true;
+                break;
+            }
+            ProbeOutcome::Down(why) => {
+                down = Some(why);
+                break;
+            }
+        }
+    }
+    let mut order: Vec<usize> = (0..n).collect();
+    if down.is_none() {
+        order.sort_by_key(|&k| (best[k].is_none(), best[k].unwrap_or(i64::MAX)));
+    }
+    ProbeOrder { order, best, cancelled, down }
+}
