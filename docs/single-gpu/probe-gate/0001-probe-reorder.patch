+        bad.argv = vec!["/nonexistent/quip-probe".into()];
+        let mut h = Helper::new();
+        let o = order_by_probe(3, &mut |_| h.probe_file(&bad, &p, -42, &g, &|| false), &|| false);
+        assert_eq!(o.order, vec![0, 1, 2]);
+        assert!(o.down.as_deref().is_some_and(|e| e.contains("spawn")), "{o:?}");
+        // dies after one probe: the next probe finds it gone, ladder order (the first result is ignored)
+        c.argv = pcfg("--stage probe --die-after 1").unwrap().argv;
+        let mut h = Helper::new();
+        let o = order_by_probe(3, &mut |_| h.probe_file(&c, &p, -42, &g, &|| false), &|| false);
+        assert_eq!(o.order, vec![0, 1, 2]);
+        assert!(o.best[0].is_some() && o.down.is_some(), "{o:?}");
+        // and while it may not respawn yet, it stays down
+        c.respawn = Duration::from_secs(60);
+        assert!(matches!(h.probe_file(&c, &p, -42, &g, &|| false), ProbeOutcome::Down(ref e) if e.contains("respawn")));
+        // a hung probe (timeout) is killed: down
+        let mut slow = pcfg("--stage probe --sleep 30").unwrap();
+        slow.timeout = Duration::from_secs(1);
