+/// Patch 43: how many entries of the solve order get a full solve.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SolveCut {
+    /// No limit configured, or probing was cancelled: top-K as in patch 42.
+    Off,
+    /// The limit is set but no probe verified (every probe failed, or the helper is down): top-K as in
+    /// patch 42. `down` = the probe helper is down (its own warning already covers it).
+    NoVerified {
+        /// The probe helper is down.
+        down: bool,
+    },
+    /// The limit applies: this many leading entries of the order (0..=top-K) clear it.
+    Applied(usize),
+}
+
+impl SolveCut {
+    /// Full solves to run out of `topk`.
+    #[must_use]
+    pub const fn count(self, topk: usize) -> usize {
+        match self {
+            Self::Off | Self::NoVerified { .. } => topk,
+            Self::Applied(k) => k,
+        }
+    }
+}
+
+/// Patch 43: apply `QUIP_OTSUKA_BP_SOLVE_MAX` to a probe result. `order` is the solve order (positions,
+/// probe order first, then unprobed extension positions); `po.best` holds the verified probe energies.
+/// Walks the first `topk` entries of `order` and counts them while each one's verified probe energy is
+/// <= `limit`, stopping at the first that is not (a failed or unprobed entry never clears it).
+#[must_use]
+pub fn solve_cut(po: &ProbeOrder, order: &[usize], topk: usize, limit: Option<i64>) -> SolveCut {
+    let Some(limit) = limit else {
+        return SolveCut::Off;
+    };
+    if po.cancelled {
+        return SolveCut::Off;
+    }
+    if po.down.is_some() {
+        return SolveCut::NoVerified { down: true };
+    }
+    if po.best.iter().all(Option::is_none) {
+        return SolveCut::NoVerified { down: false };
+    }
+    let k = order
+        .iter()
+        .take(topk)
+        .take_while(|&&j| po.best.get(j).copied().flatten().is_some_and(|e| e <= limit))
+        .count();
+    SolveCut::Applied(k)
+}
+
 /// The helper's environment: only the variables PROTOCOL.md lists, taken from ours, plus
 /// `QUIP_TWO_PASS_REFINEMENT=native-cluster-rebase`.
 #[must_use]
@@ -1635,4 +1715,111 @@ mod tests {
