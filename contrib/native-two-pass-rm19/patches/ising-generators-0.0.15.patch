+/// quip-cpu-screener: the salt-independent part of [`select`], computed once per topology.
+pub struct Prep {
+    free: Vec<Tile>,
+    adj: Vec<Vec<(usize, Tile)>>,
+    n_right: usize,
+}
+
+/// The part of [`select`] that does not depend on the shuffles.
+pub fn prepare(candidates: &Candidates, sides: &Sides) -> Result<Prep, StructureError> {
+    let mut tile_of: BTreeMap<(usize, usize), Tile> = BTreeMap::new();
+    let mut free: Vec<Tile> = Vec::new();
+    for (tile, spine) in candidates.tiles.iter().zip(&candidates.spines) {
+        let Some([e, f]) = spine else {
+            free.push(*tile);
+            continue;
+        };
+        let straight = (sides.left.binary_search(e), sides.right.binary_search(f));
+        let swapped = (sides.left.binary_search(f), sides.right.binary_search(e));
+        let (Ok(l), Ok(r)) = (if straight.0.is_ok() { straight } else { swapped }) else {
+            return Err(StructureError::Overflow);
+        };
+        if tile_of.insert((l, r), *tile).is_some() {
+            return Err(StructureError::Overflow);
+        }
+    }
+    let mut adj: Vec<Vec<(usize, Tile)>> = vec![Vec::new(); sides.left.len()];
+    for (&(l, r), tile) in &tile_of {
+        adj.get_mut(l).ok_or(StructureError::Overflow)?.push((r, *tile));
+    }
+    Ok(Prep { free, adj, n_right: sides.right.len() })
+}
+
+/// Same result as [`select`], for orders that are known to be permutations.
+pub fn select_prepared(prep: &Prep, left_order: &[u32], right_order: &[u32]) -> Result<Vec<Tile>, StructureError> {
+    let mut rank = vec![usize::MAX; prep.n_right];
+    for (position, &index) in right_order.iter().enumerate() {
+        *rank.get_mut(index as usize).ok_or(StructureError::BadOrder)? = position;
+    }
+    let mut adj: Vec<Vec<usize>> = prep
+        .adj
+        .iter()
+        .map(|l| {
+            let mut v: Vec<usize> = l.iter().map(|&(r, _)| r).collect();
+            v.sort_by_key(|r| rank.get(*r).copied().unwrap_or(usize::MAX));
+            v
+        })
+        .collect();
+    let mut matched: Vec<Option<usize>> = vec![None; prep.n_right];
+    let mut visited = vec![false; prep.n_right];
+    for &l in left_order {
+        visited.iter_mut().for_each(|v| *v = false);
+        augment(l as usize, &adj, &mut visited, &mut matched)?;
+    }
+    let mut selected: Vec<Tile> = prep.free.clone();
+    for (r, owner) in matched.iter().enumerate() {
+        if let Some(l) = owner {
+            let tile = prep.adj.get(*l).and_then(|v| v.iter().find(|&&(rr, _)| rr == r)).map(|&(_, t)| t).ok_or(StructureError::Overflow)?;
+            selected.push(tile);
+        }
+    }
+    selected.sort_unstable();
+    adj.clear();
+    Ok(selected)
+}
+
+/// quip-cpu-screener: the salt-independent tables of [`select`] with candidate indices, for the GPU port.
+/// Returns the free candidate indices and, per left spine, `(right spine, candidate index)` ascending in the right spine.
+pub fn prepare_tables(candidates: &Candidates, sides: &Sides) -> Result<(Vec<usize>, Vec<Vec<(usize, usize)>>), StructureError> {
+    let mut tile_of: BTreeMap<(usize, usize), usize> = BTreeMap::new();
+    let mut free = Vec::new();
+    for (idx, spine) in candidates.spines.iter().enumerate() {
+        let Some([e, f]) = spine else { free.push(idx); continue };
+        let straight = (sides.left.binary_search(e), sides.right.binary_search(f));
+        let swapped = (sides.left.binary_search(f), sides.right.binary_search(e));
+        let (Ok(l), Ok(r)) = (if straight.0.is_ok() { straight } else { swapped }) else { return Err(StructureError::Overflow) };
+        if tile_of.insert((l, r), idx).is_some() { return Err(StructureError::Overflow); }
+    }
+    let mut adj: Vec<Vec<(usize, usize)>> = vec![Vec::new(); sides.left.len()];
+    for (&(l, r), &idx) in &tile_of { adj.get_mut(l).ok_or(StructureError::Overflow)?.push((r, idx)); }
+    Ok((free, adj))
+}
