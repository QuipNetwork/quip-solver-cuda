+    // ---- patch 43 ----
+
+    fn po(best: Vec<Option<i64>>) -> ProbeOrder {
+        let n = best.len();
+        let mut order: Vec<usize> = (0..n).collect();
+        order.sort_by_key(|&k| (best[k].is_none(), best[k].unwrap_or(i64::MAX)));
+        ProbeOrder { order, best, cancelled: false, down: None }
+    }
+
+    #[test]
+    fn solve_max_cfg() {
+        assert_eq!(parse_solve_max("-5084000"), Some(-5_084_000));
+        assert_eq!(parse_solve_max(" -5084000 "), Some(-5_084_000));
+        assert_eq!(parse_solve_max(""), None);
+        assert_eq!(parse_solve_max("-5084.0"), None);
+        assert_eq!(parse_solve_max("off"), None);
+        let main = BpCfg::with_cmd("main --serve").unwrap();
+        let get = |sm: Option<&'static str>| {
+            move |k: &str| match k {
+                "QUIP_OTSUKA_BP_PROBE_HELPER" => Some("probe".to_string()),
+                "QUIP_OTSUKA_BP_SOLVE_MAX" => sm.map(str::to_string),
+                _ => None,
+            }
+        };
+        // unset / blank: off and not shown
+        let pc = probe_cfg_with(&main, &get(None)).unwrap();
+        assert_eq!((pc.solve_max, pc.solve_max_set), (None, false));
+        let pc = probe_cfg_with(&main, &get(Some("  "))).unwrap();
+        assert_eq!((pc.solve_max, pc.solve_max_set), (None, false));
+        // set: on; garbage: off but shown
+        let pc = probe_cfg_with(&main, &get(Some("-5084000"))).unwrap();
+        assert_eq!((pc.solve_max, pc.solve_max_set), (Some(-5_084_000), true));
+        let pc = probe_cfg_with(&main, &get(Some("x"))).unwrap();
+        assert_eq!((pc.solve_max, pc.solve_max_set), (None, true));
+        // without the probe helper there is no probe config, so the limit cannot apply
+        assert!(probe_cfg_with(&main, &|k| (k == "QUIP_OTSUKA_BP_SOLVE_MAX").then(|| "-5084000".to_string())).is_none());
+    }
+
+    #[test]
+    fn solve_cut_rules() {
+        let lim = Some(-5_084_000);
+        // limit off: top-K as before, whatever the probes say
+        let p = po(vec![Some(-5_080_000), Some(-5_070_000)]);
+        assert_eq!(solve_cut(&p, &p.order, 1, None), SolveCut::Off);
+        assert_eq!(solve_cut(&p, &p.order, 1, None).count(1), 1);
+        assert_eq!(solve_cut(&p, &p.order, 2, None).count(2), 2);
+        // best clears (TOPK 1)
+        let p = po(vec![Some(-5_082_000), Some(-5_086_000), Some(-5_079_000), Some(-5_083_000)]);
+        assert_eq!(p.order, vec![1, 3, 0, 2]);
+        assert_eq!(solve_cut(&p, &p.order, 1, lim), SolveCut::Applied(1));
+        // best fails the limit: nothing solved
+        let p = po(vec![Some(-5_082_000), Some(-5_083_999), Some(-5_079_000), Some(-5_083_000)]);
+        assert_eq!(solve_cut(&p, &p.order, 1, lim), SolveCut::Applied(0));
+        assert_eq!(solve_cut(&p, &p.order, 2, lim).count(2), 0);
+        // TOPK 2: rank 2 clears / does not clear
+        let p = po(vec![Some(-5_082_000), Some(-5_086_000), Some(-5_079_000), Some(-5_085_000)]);
+        assert_eq!(solve_cut(&p, &p.order, 2, lim), SolveCut::Applied(2));
+        let p = po(vec![Some(-5_082_000), Some(-5_086_000), Some(-5_079_000), Some(-5_083_000)]);
+        assert_eq!(solve_cut(&p, &p.order, 2, lim), SolveCut::Applied(1));
+        // TOPK larger than what clears, and than the order
+        let p = po(vec![Some(-5_090_000), Some(-5_086_000)]);
+        assert_eq!(solve_cut(&p, &p.order, 8, lim), SolveCut::Applied(2));
+        // ties: exactly at the limit clears (<=); equal probes keep ladder order and both clear
+        let p = po(vec![Some(-5_084_000), Some(-5_084_000), Some(-5_083_999)]);
+        assert_eq!(p.order, vec![0, 1, 2]);
+        assert_eq!(solve_cut(&p, &p.order, 1, lim), SolveCut::Applied(1));
+        assert_eq!(solve_cut(&p, &p.order, 3, lim), SolveCut::Applied(2));
+        // a failed probe never clears: rank 2 is a failed probe after one that clears
+        let p = po(vec![None, Some(-5_086_000), None, None]);
+        assert_eq!(p.order, vec![1, 0, 2, 3]);
+        assert_eq!(solve_cut(&p, &p.order, 2, lim), SolveCut::Applied(1));
+        // the ladder winner's probe failed and the only verified probe is above the limit: nothing solved
+        let p = po(vec![None, Some(-5_080_000), Some(-5_070_000), None]);
+        assert_eq!(solve_cut(&p, &p.order, 2, lim), SolveCut::Applied(0));
+        // unprobed extension entries (TOPK > n) never clear
+        let p = po(vec![Some(-5_090_000), Some(-5_089_000)]);
+        let mut order = p.order.clone();
+        order.extend(2..4);
+        assert_eq!(solve_cut(&p, &order, 4, lim), SolveCut::Applied(2));
+        // every probe failed: the limit is not applied (patch 42 behaviour: top-K in ladder order)
+        let p = po(vec![None, None, None, None]);
+        assert_eq!(solve_cut(&p, &p.order, 2, lim), SolveCut::NoVerified { down: false });
+        assert_eq!(solve_cut(&p, &p.order, 2, lim).count(2), 2);
+        // the probe helper is down (even after a verified probe): not applied
+        let mut p = po(vec![Some(-5_070_000), None, None, None]);
+        p.down = Some("gone".into());
+        p.order = vec![0, 1, 2, 3];
+        assert_eq!(solve_cut(&p, &p.order, 1, lim), SolveCut::NoVerified { down: true });
+        assert_eq!(solve_cut(&p, &p.order, 1, lim).count(1), 1);
+        // probing cancelled (the lease stopped): off; nothing is solved anyway since the lease stopped
+        let mut p = po(vec![Some(-5_070_000), None]);
+        p.cancelled = true;
+        assert_eq!(solve_cut(&p, &p.order, 1, lim), SolveCut::Off);
+    }
+
+    #[test]
+    fn solve_cut_on_real_probe_orders() {
+        // order_by_probe output fed straight in, as the lease does
+        let o = order_by_probe(4, &mut scripted(vec![best(-5_083_000), best(-5_085_500), ProbeOutcome::Failed("x".into()), best(-5_084_000)]), &|| false);
+        assert_eq!(o.order, vec![1, 3, 0, 2]);
+        assert_eq!(solve_cut(&o, &o.order, 2, Some(-5_084_000)), SolveCut::Applied(2));
+        assert_eq!(solve_cut(&o, &o.order, 2, Some(-5_085_000)), SolveCut::Applied(1));
+        assert_eq!(solve_cut(&o, &o.order, 2, Some(-5_086_000)), SolveCut::Applied(0));
+        let o = order_by_probe(3, &mut |k| if k == 0 { best(-5_090_000) } else { ProbeOutcome::Down("gone".into()) }, &|| false);
+        assert_eq!(solve_cut(&o, &o.order, 1, Some(-5_095_000)), SolveCut::NoVerified { down: true });
+    }
 }
