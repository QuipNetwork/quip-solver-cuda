+static PROBE: Mutex<Helper> = Mutex::new(Helper::new());
+static PROBE_DOWN: AtomicBool = AtomicBool::new(false);
+
+/// `Helper::probe_via_helper` on the process-wide probe helper (patch 42; started at first use, kept across
+/// leases). Warns once when it goes down and logs once when it answers again.
+pub fn probe(cfg: &BpCfg, inst: &Instance, graph: &IsingGraph, stopped: &dyn Fn() -> bool) -> ProbeOutcome {
+    let out = PROBE.lock().unwrap_or_else(PoisonError::into_inner).probe_via_helper(cfg, inst, graph, stopped);
+    match &out {
+        ProbeOutcome::Down(why) => {
+            if !PROBE_DOWN.swap(true, Ordering::Relaxed) {
+                tracing::warn!(reason = why.as_str(), "gpu-pa bp probe helper unavailable; the ladder order is used until it is back");
+            }
+        }
+        ProbeOutcome::Best { .. } | ProbeOutcome::Failed(_) => {
+            if PROBE_DOWN.swap(false, Ordering::Relaxed) {
+                tracing::info!("gpu-pa bp probe helper back; probing again");
+            }
+        }
+        ProbeOutcome::Cancelled => {}
+    }
+    out
+}
+
+/// Wait out a cancelled solve still running in the main helper (patch 42: before probing, so the two
+/// helpers never run at the same time). Never spawns.
+pub fn settle_main(cfg: &BpCfg, stopped: &dyn Fn() -> bool) -> Result<(), Fail> {
+    HELPER.lock().unwrap_or_else(PoisonError::into_inner).settle(cfg, stopped)
+}
+
+/// Wait out a cancelled probe still running in the probe helper (patch 42: before the full solves).
+pub fn settle_probe(cfg: &BpCfg, stopped: &dyn Fn() -> bool) -> Result<(), Fail> {
+    PROBE.lock().unwrap_or_else(PoisonError::into_inner).settle(cfg, stopped)
+}
