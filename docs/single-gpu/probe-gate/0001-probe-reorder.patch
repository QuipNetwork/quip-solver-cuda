+    #[test]
+    fn stop_mid_probing_returns_fast() {
+        let Some(c) = pcfg("--stage probe --sleep 2") else { return };
+        let files: Vec<(PathBuf, IsingGraph)> = [("ps-a", 1u64), ("ps-b", 2), ("ps-c", 3)].iter().map(|&(t, s)| mid_file_seeded(t, s)).collect();
+        let mut h = Helper::new();
+        h.ensure(&c, &|| false).unwrap();
+        let flag = Arc::new(AtomicBool::new(false));
+        let f2 = Arc::clone(&flag);
+        // the first probe takes 2 s; stop 300 ms into it
+        let t = std::thread::spawn(move || {
+            std::thread::sleep(Duration::from_millis(300));
+            f2.store(true, Ordering::SeqCst);
+            Instant::now()
+        });
+        let stopped = || flag.load(Ordering::SeqCst);
+        let mut asked = 0;
+        let o = order_by_probe(3, &mut |k| { asked += 1; h.probe_file(&c, &files[k].0, -42, &files[k].1, &stopped) }, &stopped);
+        let back = Instant::now();
+        let lag = back.duration_since(t.join().unwrap());
+        eprintln!("probing returned {} ms after the stop", lag.as_millis());
+        assert!(o.cancelled && asked == 1, "{o:?} {asked}");
+        assert!(lag < Duration::from_millis(150), "{lag:?}");
+        // the cancel was answered inline; the helper serves the next probe at once
+        assert!(h.proc.as_ref().unwrap().pending.is_none());
+        let fast = BpCfg { argv: pcfg("--stage probe").unwrap().argv, ..c };
+        assert!(h.settle(&fast, &|| false).is_ok());
+        assert!(matches!(h.probe_file(&fast, &files[0].0, -42, &files[0].1, &|| false), ProbeOutcome::Best { .. }));
+    }
+
+    #[test]
+    fn settle_waits_for_a_deferred_cancel() {
+        // a helper that ignores cancel: the stopped probe returns after cancel_inline; settle then waits for
+        // the stale answer before anything else uses the GPU
+        let Some(mut c) = pcfg("--stage probe --sleep 1 --ignore-cancel") else { return };
+        c.cancel_inline = Duration::from_millis(100);
+        let (p, g) = mid_file_seeded("pset", 9);
+        let mut h = Helper::new();
+        h.ensure(&c, &|| false).unwrap();
+        let t0 = Instant::now();
+        assert_eq!(h.probe_file(&c, &p, -42, &g, &|| t0.elapsed() > Duration::from_millis(200)), ProbeOutcome::Cancelled);
+        assert!(h.proc.as_ref().unwrap().pending.is_some());
+        assert!(h.settle(&c, &|| false).is_ok());
+        assert!(t0.elapsed() >= Duration::from_millis(900), "{:?}", t0.elapsed());
+        assert!(h.proc.as_ref().unwrap().pending.is_none());
+        // settle on an empty slot is a no-op
+        assert!(Helper::new().settle(&c, &|| false).is_ok());
+    }
