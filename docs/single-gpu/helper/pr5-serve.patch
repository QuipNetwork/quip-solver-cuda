+struct GpuSlot;
+impl GpuSlot{fn acquire(limit:usize,stopped:&dyn Fn()->bool)->Result<Self,SampleError>{let(m,cv)=&GPU_SLOTS;let mut used=m.lock().unwrap_or_else(|e|e.into_inner());loop{if *used<limit.max(1){*used+=1;return Ok(GpuSlot);}if stopped(){return Err(SampleError::DeviceBusy);}used=cv.wait_timeout(used,std::time::Duration::from_millis(100)).unwrap_or_else(|e|e.into_inner()).0;}}}
+impl Drop for GpuSlot{fn drop(&mut self){let(m,cv)=&GPU_SLOTS;let mut used=m.lock().unwrap_or_else(|e|e.into_inner());*used=used.saturating_sub(1);drop(used);cv.notify_one();}}
