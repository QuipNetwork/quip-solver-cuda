+// structural prefilter patch: CPU structural prefilter (opt-in; struct_cutoff unset = unchanged behaviour).
+// A rejected salt returns one valid read: every spin +1, whose exact energy over the instance's
+// own h/J/edges is sum(h)+sum(J) (each J term is J*s_u*s_v = J, self-edges included), the same
+// integer-milli value graph_score() recomputes in family_until.
+fn struct_reject_read(instance:&Instance)->Result<SamplerResult,String>{
+    let(h,j,edges)=(instance.h(),instance.j(),instance.edges());let n=h.len();
+    if n==0||edges.len()!=j.len()||edges.iter().any(|&(u,v)|u as usize>=n||v as usize>=n){return Err("struct reject read: graph shape".into());}
+    let energy=h.iter().map(|&v|i64::from(v)).sum::<i64>()+j.iter().map(|&v|i64::from(v)).sum::<i64>();
+    Ok(SamplerResult{spins:vec![1i8;n],energy_milli:energy})
+}
+struct StructStats{seen:u64,rejected:u64,passed:u64,scored_passed:u64,errors:u64,passed_score_sum:f64,since:Option<Instant>}
+static STRUCT_STATS:Mutex<StructStats>=Mutex::new(StructStats{seen:0,rejected:0,passed:0,scored_passed:0,errors:0,passed_score_sum:0.,since:None});
+fn struct_record(score:Option<f64>,rejected:bool){
+    let mut s=STRUCT_STATS.lock().unwrap_or_else(|e|e.into_inner());let now=Instant::now();let since=*s.since.get_or_insert(now);
+    s.seen+=1;if rejected{s.rejected+=1;}else{s.passed+=1;match score{Some(v)=>{s.scored_passed+=1;s.passed_score_sum+=v;}None=>s.errors+=1}}
+    let window=now.duration_since(since);
+    if window.as_secs()>=60{
+        let mean=if s.scored_passed>0{Some(s.passed_score_sum/s.scored_passed as f64)}else{None};
+        tracing::info!(window_s=window.as_secs(),seen=s.seen,rejected_struct=s.rejected,passed=s.passed,score_errors=s.errors,mean_passed_score=?mean,cutoff=?search_config().struct_cutoff,"STRUCT_PREFILTER");
+        *s=StructStats{seen:0,rejected:0,passed:0,scored_passed:0,errors:0,passed_score_sum:0.,since:Some(now)};
+    }
+}
