+    #[test]
+    fn probe_order_rules() {
+        let f = |s: &str| ProbeOutcome::Failed(s.into());
+        // by energy, best first
+        let o = order_by_probe(4, &mut scripted(vec![best(-10), best(-30), best(-20), best(-5)]), &|| false);
+        assert_eq!((o.order, o.cancelled, o.down), (vec![1, 2, 0, 3], false, None));
+        // ties keep the ladder order
+        let o = order_by_probe(4, &mut scripted(vec![best(-10), best(-20), best(-20), best(-10)]), &|| false);
+        assert_eq!(o.order, vec![1, 2, 0, 3]);
+        // failed probes go last, in ladder order
+        let o = order_by_probe(4, &mut scripted(vec![f("x"), best(-1), f("y"), best(-2)]), &|| false);
+        assert_eq!(o.order, vec![3, 1, 0, 2]);
+        assert_eq!(o.best, vec![None, Some(-1), None, Some(-2)]);
+        // a down helper: ladder order, the probes after it are not asked for
+        let mut asked = 0;
+        let o = order_by_probe(
+            4,
+            &mut |k| {
+                asked += 1;
+                if k == 1 { ProbeOutcome::Down("gone".into()) } else { best(-(k as i64)) }
+            },
+            &|| false,
+        );
+        assert_eq!((o.order, o.down.as_deref(), asked), (vec![0, 1, 2, 3], Some("gone"), 2));
+        // a stop: no probe after it
