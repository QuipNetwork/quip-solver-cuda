+/// quip-cpu-screener: the sorted edge list and a per-first-node index into it depend only on the topology, so they are built once.
+struct EdgeIndex { edges: Vec<(u32, u32)>, start: Vec<u32> }
+fn edge_index(topology: &BaseTopology) -> std::sync::Arc<EdgeIndex> {
+    static CACHE: std::sync::Mutex<Option<([u8; 32], std::sync::Arc<EdgeIndex>)>> = std::sync::Mutex::new(None);
+    let mut g = CACHE.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some((d, c)) = g.as_ref() {
+        if d == topology.order_digest() { return c.clone(); }
+    }
+    let edges = sorted_edges(topology);
+    let max = edges.iter().map(|&(u, _)| u as usize).max().unwrap_or(0);
+    let mut start = vec![0u32; max + 2];
+    for &(u, _) in &edges { start[u as usize + 1] += 1; }
+    for i in 1..start.len() { start[i] += start[i - 1]; }
+    let c = std::sync::Arc::new(EdgeIndex { edges, start });
+    *g = Some((*topology.order_digest(), c.clone()));
+    c
+}
+impl EdgeIndex {
+    /// Position of `pair` in the sorted edge list (same answer as `edges.binary_search(&pair)` when present).
+    fn find(&self, pair: (u32, u32)) -> Option<usize> {
+        let (a, b) = pair;
+        let a = a as usize;
+        if a + 1 >= self.start.len() { return None; }
+        let (lo, hi) = (self.start[a] as usize, self.start[a + 1] as usize);
+        self.edges[lo..hi].binary_search_by(|e| e.1.cmp(&b)).ok().map(|i| lo + i)
+    }
+}
