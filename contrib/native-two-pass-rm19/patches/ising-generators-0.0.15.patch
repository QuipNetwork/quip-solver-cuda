diff -ruN a/src/gpugen.rs b/src/gpugen.rs
--- a/src/gpugen.rs	1970-01-01 01:00:00.000000000 +0100
+++ b/src/gpugen.rs	2026-11-25 18:12:44.658823147 +0000
@@ -0,0 +1,84 @@
+//! quip-cpu-screener: the salt-independent tables and per-salt seeds that a GPU port of the
+//! `quip/twisted-ice-dimer` generator needs. Nothing here changes how instances are generated.
+
+use alloc::vec::Vec;
+
+use crate::descriptor::{admit, params_digest};
+use crate::family::BaseTopology;
+use crate::ice::build::{lattice, sorted_edges};
+use crate::ice::{candidates, prepare_tables, sides, TWISTED_DIMER_V1};
+use crate::rng::stream_seed;
+
+/// Stream labels in the order the GPU kernel expects them.
+pub const LABELS: [&str; 5] = ["left", "right", "gauge", "weak", "dimer"];
+
+/// Everything the generator needs that does not depend on the salt.
+pub struct GenData {
+    pub n_nodes: u32,
+    pub weak: i32,
+    pub pairs: u32,
+    /// Sorted edges (min, max).
+    pub edges: Vec<(u32, u32)>,
+    pub n_left: u32,
+    pub n_right: u32,
+    /// Candidate tiles, ascending (the order selected tiles are sorted in): the six edge indices of each.
+    pub cand_edges: Vec<[u32; 6]>,
+    /// Candidate indices of the free tiles (always selected).
+    pub free: Vec<u32>,
+    /// Left spine `l` owns `adj_r[adj_start[l]..adj_start[l + 1]]`, right spines ascending, with the candidate index in `adj_cand`.
+    pub adj_start: Vec<u32>,
+    pub adj_r: Vec<u32>,
+    pub adj_cand: Vec<u32>,
+    descriptor_digest: [u8; 32],
+    order_digest: [u8; 32],
+}
+
+pub fn gen_data(params: &[u8], topology: &BaseTopology) -> Result<GenData, alloc::string::String> {
+    let contracts = [TWISTED_DIMER_V1];
+    let admitted = admit(&contracts, TWISTED_DIMER_V1.family_id.as_bytes(), TWISTED_DIMER_V1.revision, params, &params_digest(params))
+        .map_err(|c| alloc::format!("admit: {c:?}"))?;
+    let lat = lattice(admitted.params()).map_err(|e| alloc::format!("lattice: {e:?}"))?;
+    let (weak, pairs) = crate::ice::twisted_dimer::gpu_params(admitted.params()).ok_or("params")?;
+    let found = candidates(lat, topology).map_err(|e| alloc::format!("candidates: {e:?}"))?;
+    let split = sides(lat, topology, &found).map_err(|e| alloc::format!("sides: {e:?}"))?;
+    let edges = sorted_edges(topology);
+    let find = |p: (u32, u32)| edges.binary_search(&p).map(|i| i as u32).map_err(|_| alloc::string::String::from("tile edge not found"));
+    let mut cand_edges = Vec::new();
+    for t in &found.tiles {
+        let [a, b, c, d] = t.nodes;
+        cand_edges.push([find((a, b))?, find((a, c))?, find((a, d))?, find((b, c))?, find((b, d))?, find((c, d))?]);
+    }
+    let (free, adj) = prepare_tables(&found, &split).map_err(|e| alloc::format!("tables: {e:?}"))?;
+    let mut adj_start = Vec::new();
+    let (mut adj_r, mut adj_cand) = (Vec::new(), Vec::new());
+    for list in &adj {
+        adj_start.push(adj_r.len() as u32);
+        for &(r, cand) in list {
+            adj_r.push(r as u32);
+            adj_cand.push(cand as u32);
+        }
+    }
+    adj_start.push(adj_r.len() as u32);
+    Ok(GenData {
+        n_nodes: topology.node_ids().len() as u32,
+        weak,
+        pairs: pairs as u32,
+        edges,
+        n_left: split.left.len() as u32,
+        n_right: split.right.len() as u32,
+        cand_edges,
+        free: free.into_iter().map(|i| i as u32).collect(),
+        adj_start,
+        adj_r,
+        adj_cand,
+        descriptor_digest: admitted.descriptor().digest(),
+        order_digest: *topology.order_digest(),
+    })
+}
+
+impl GenData {
+    /// The five substream seeds of a salt, in [`LABELS`] order.
+    pub fn seeds(&self, nonce: &[u8; 32]) -> [[u8; 32]; 5] {
+        LABELS.map(|l| stream_seed(nonce, &self.descriptor_digest, &self.order_digest, l.as_bytes()).expect("valid label"))
+    }
+}
