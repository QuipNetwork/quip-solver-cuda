+    /// Probe `inst` (lease graph `graph`) once through this helper (patch 42): shift 0, one read, the
+    /// returned read verified exactly as for full solves.
+    pub fn probe_via_helper(&mut self, cfg: &BpCfg, inst: &Instance, graph: &IsingGraph, stopped: &dyn Fn() -> bool) -> ProbeOutcome {
+        if stopped() {
+            return ProbeOutcome::Cancelled;
+        }
+        let path = match self.write_instance(cfg, inst) {
+            Ok(p) => p,
+            Err(e) => return ProbeOutcome::Failed(e),
+        };
+        let out = self.probe_file(cfg, &path, inst.offset_milli(), graph, stopped);
+        let _ = std::fs::remove_file(&path);
+        out
+    }
+
+    fn probe_file(&mut self, cfg: &BpCfg, path: &Path, offset: i64, graph: &IsingGraph, stopped: &dyn Fn() -> bool) -> ProbeOutcome {
+        match self.request(cfg, path, 0, 1, stopped) {
+            Ok(a) => {
+                let (ok, bad) = verify_reads(graph, offset, &a.reads);
+                for b in &bad {
+                    tracing::error!(why = b.as_str(), "gpu-pa bp probe read rejected");
+                }
+                match ok.first() {
+                    Some(r) => ProbeOutcome::Best { energy: r.energy_milli, helper_ms: a.solve_ms, stage: a.stage, screened_out: a.screened_out },
+                    None => ProbeOutcome::Failed(format!("no read verified ({} sent, {} rejected)", a.reads.len(), bad.len())),
+                }
+            }
+            Err(Fail::Cancelled) => ProbeOutcome::Cancelled,
+            Err(Fail::Failed(e)) if self.alive() => ProbeOutcome::Failed(e),
+            Err(Fail::Failed(e)) => ProbeOutcome::Down(e),
+        }
+    }
 }
 
